# v2.1 rollback safety net — local-only, not for production.
# Lives in assets-src/ (outside public/) so Vite doesn't ship it to Vercel.
# One-command rollback: `rm -rf public/ppf && mv assets-src/ppf/v2-1-backup public/ppf`.
assets-src/ppf/v2-1-backup/
